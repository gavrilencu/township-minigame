# Connection to an existing PostgreSQL database. The database must already exist;
# create the game's tables once with `npm run db:migrate`.
#
# npm run dev (.env.local):      postgres://USER:PASSWORD@localhost:5432/DATABASE
# Docker on the same computer (.env): postgres://USER:PASSWORD@host.docker.internal:5432/DATABASE
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
# Set to "true" for hosted databases that require SSL (Neon, Supabase, Render...)
PGSSL=false
# "true" = the game creates its missing tables at startup (never the database itself).
# Handy on hosting panels where `npm run db:migrate` cannot be run once by hand.
DB_MIGRATE_ON_START=false
# Host port for `docker compose` (default 3000)
# APP_PORT=3000
